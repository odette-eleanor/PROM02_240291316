# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Poetry
poetry.lock.bak

# Data (never commit datasets - point teammates/supervisors to the download source instead)
# Dataset files and large archives
data/raw/
data/archives/
data/processed/

# Ignore other data files by default
data/*
!data/.gitkeep
!data/splits/
data/splits/*
!data/splits/*.csv

# Model checkpoints / large artifacts
checkpoints/
*.pth
*.pt
*.ckpt

# Notebooks checkpoints
.ipynb_checkpoints/

# Docker volumes if run locally
docker/prometheus_data/
docker/grafana_data/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Env
.env
